{
  "name": "ecommerce-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-seller marketplace API with atomic inventory checkout and SQLite.",
  "engines": { "node": ">=24.15" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && cp public/index.html public/styles.css dist/public/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/migrate.js",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
